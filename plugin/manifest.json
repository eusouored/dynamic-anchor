{
  "manifestVersion": 5,
  "id": "com.dynamic.anchor",
  "name": "Dynamic Anchor",
  "version": "1.7.2",
  "main": "index.html",
  "host": {
    "app": "premierepro",
    "minVersion": "26.0.0"
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "dynamicAnchor",
      "label": {
        "default": "Dynamic Anchor"
      },
      "minimumSize": {
        "width": 280,
        "height": 300
      },
      "maximumSize": {
        "width": 2000,
        "height": 2000
      },
      "preferredDockedSize": {
        "width": 390,
        "height": 760
      },
      "preferredFloatingSize": {
        "width": 410,
        "height": 800
      },
      "icons": [
        {
          "width": 23,
          "height": 23,
          "path": "icons/da-panel-dark.svg",
          "scale": [
            1
          ],
          "theme": [
            "darkest",
            "dark",
            "medium"
          ]
        },
        {
          "width": 23,
          "height": 23,
          "path": "icons/da-panel-light.svg",
          "scale": [
            1
          ],
          "theme": [
            "lightest",
            "light"
          ]
        }
      ]
    }
  ],
  "icons": [
    {
      "width": 48,
      "height": 48,
      "path": "icons/da-icon-48.png",
      "scale": [
        1,
        2
      ],
      "theme": [
        "all"
      ],
      "species": [
        "pluginList"
      ]
    }
  ],
  "requiredPermissions": {
    "localFileSystem": "request",
    "clipboard": "readAndWrite",
    "network": {
      "domains": [
        "http://127.0.0.1:47833",
        "http://127.0.0.1:47833/",
        "http://127.0.0.1",
        "http://127.0.0.1/",
        "http://localhost:47833",
        "http://localhost"
      ]
    },
    "launchProcess": {
      "schemes": [
        "https"
      ],
      "extensions": [
        ".bat"
      ]
    }
  }
}